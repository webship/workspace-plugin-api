{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": false
  },
  "include": ["index.d.ts", "src/**/*.ts", "tests/**/*.ts", "tests/**/*.mts"]
}
